[Unit]
Description=Check for idle Minecraft server

[Service]
Type=oneshot
# A hung check would block every later timer run (OnUnitActiveSec never re-arms)
TimeoutStartSec=2min
User=minecraft
EnvironmentFile=-/etc/minecraft.env
ExecStart=/usr/local/bin/autoshutdown.sh
# Idle-check state (/run/autoshutdown), owned by User= and kept until reboot
RuntimeDirectory=autoshutdown
RuntimeDirectoryPreserve=yes
ProtectSystem=full
ProtectHome=yes
NoNewPrivileges=no
