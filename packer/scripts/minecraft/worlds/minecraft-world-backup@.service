[Unit]
Description=Backup Minecraft world %i
After=network-online.target

[Service]
Type=oneshot
User=minecraft
EnvironmentFile=-/etc/minecraft.env
# restic's default cache is in ~minecraft, which minecraft@.service hides
# (ProtectHome). Share one cache in /var/cache/restic across the backup units.
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=%C/restic
ExecStartPre=-/usr/local/bin/minecraftctl rcon send "say Backing up world data..."
ExecStartPre=-/usr/local/bin/minecraftctl rcon send "save-all"
ExecStart=/usr/local/bin/minecraftctl backup create %i
