[Unit]
Description=Prune old Minecraft world backups
After=network-online.target

[Service]
Type=oneshot
User=minecraft
EnvironmentFile=-/etc/minecraft.env
# Yield to the Minecraft server when they overlap (boot catch-up, play).
# IOWeight only bites with BFQ or iocost; EBS nvme defaults to "none".
Nice=10
CPUWeight=20
IOWeight=20
ExecStart=/usr/local/bin/minecraftctl backup prune
