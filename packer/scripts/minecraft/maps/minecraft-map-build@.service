[Unit]
Description=Build Minecraft map for %i
After=minecraft@%i.service
# Upload the maps once they're built. Maps only change here, so this replaces
# uploading them when the world stops, which held up every stop by ~8s.
OnSuccess=minecraft-map-backup@%i.service

[Service]
Type=oneshot
User=minecraft
EnvironmentFile=-/etc/minecraft.env

# Yield to the Minecraft server when they overlap (boot catch-up, play).
# IOWeight only bites with BFQ or iocost; EBS nvme defaults to "none".
Nice=10
CPUWeight=20
IOWeight=20

# Save world first if Minecraft is running (fails silently if not)
ExecStartPre=-/usr/local/bin/minecraftctl rcon send "say Saving world before map build..."
ExecStartPre=-/usr/local/bin/minecraftctl rcon send "save-all"

# Build the maps, then the world's manifests and the aggregate index
ExecStart=/usr/local/bin/minecraftctl map build now %i
ExecStartPost=/usr/local/bin/minecraftctl map manifest %i --update-index
